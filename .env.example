# Скопируйте в .env и заполните. Файл .env не коммитится.

# Токен бота из кабинета MAX для партнёров (Чат-боты → ⋮ → Настройки). ОБЯЗАТЕЛЬНО.
MAX_BOT_TOKEN=
# Ник бота без @ — нужен для кнопки открытия мини-приложения и ссылок ?startapp=. ОБЯЗАТЕЛЬНО.
MAX_BOT_USERNAME=

# user_id администраторов через запятую: только так выдаются права, регистрации админа нет.
# Номер видно в таблице users или в журнале правок. Пусто — админов нет.
ADMIN_USER_IDS=

# PostgreSQL. Локально и в docker compose база поднимается рядом из этих трёх строк.
POSTGRES_USER=aperio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aperio

# Готовая строка подключения. Нужна только там, где база НЕ поднимается рядом:
# на хостинге, который собирает один контейнер по Dockerfile. Тогда сюда идут
# данные управляемой базы: postgres://пользователь:пароль@хост:5432/база
# Локально эту строку оставляйте пустой — её соберёт docker compose.
DATABASE_URL=

# Корневой сертификат управляемой базы: текст PEM целиком или путь к файлу.
# Нужен, только если хостинг выдал строку с sslmode=verify-ca или verify-full.
# Если сертификата нет — замените в строке подключения sslmode=verify-full на
# sslmode=require: соединение останется шифрованным, но сертификат
# проверяться не будет.
DATABASE_CA_CERT=

# Порт на хосте
APP_PORT=8080

# Открывать мини-приложение в браузере без MAX (http://localhost:8080/?dev=1). Только для локальной проверки!
ALLOW_DEV_AUTH=false
# Срок жизни данных запуска и сессии, секунд. Сессия админа живёт меньше:
# её токен виден в адресной строке, а значит может утечь со скриншота.
INIT_DATA_TTL_SEC=3600
SESSION_TTL_SEC=86400
ADMIN_SESSION_TTL_SEC=7200

# Через сколько секунд открывается демо-окно записи
DEMO_DELAY_SEC=60
# Период планировщика, секунд
WORKER_INTERVAL_SEC=15
# Загружать начальные данные в пустую базу
SEED_ON_START=true
